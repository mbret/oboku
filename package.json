{
  "name": "root",
  "version": "2.1.1",
  "private": true,
  "repository": "git@github.com:mbret/oboku.git",
  "author": "Maxime Bret <bret.maxime@gmail.com>",
  "license": "GPL-3.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait couchdb postgres dev-proxy",
    "start": "pnpm run docker:dev:infra && pnpm run build:api && lerna run start:dev --stream",
    "start:lib": "lerna run start:dev --scope=@oboku/shared --scope=@oboku/synology",
    "start:web": "lerna run start:dev --scope=@oboku/web",
    "start:landing": "lerna run dev --scope=@oboku/landing",
    "start:api": "pnpm run build:api && lerna run start:dev --scope=@oboku/api",
    "start:admin": "lerna run start --scope=@oboku/admin",
    "build": "lerna run build",
    "build:web": "lerna run build --scope=@oboku/web",
    "build:api": "lerna run build --scope=@oboku/api",
    "build:landing": "lerna run build --scope=@oboku/landing",
    "test": "lerna run test",
    "tsc": "lerna run tsc",
    "format": "biome format --write .",
    "lint": "biome check .",
    "nuke": "node scripts/nuke.mjs",
    "prepare": "husky",
    "postinstall": "node scripts/check-dexie-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@rollup/plugin-replace": "^6.0.3",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.13.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0",
    "rollup": "^4.62.4",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-node-externals": "^9.0.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.3",
    "vercel": "^59.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/client-ssm": "^3.1103.0",
    "@emotion/cache": "^11.14.0",
    "@microsoft/api-extractor": "^7.58.12"
  },
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true --write"
    ]
  }
}
