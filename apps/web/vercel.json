{
  "installCommand": "npm i -g pnpm@11 && cd ../.. && pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/auth-callback-dropbox",
      "destination": "/auth-callback-dropbox.html"
    },
    {
      "source": "/auth-callback-microsoft",
      "destination": "/auth-callback-microsoft.html"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  }
}
