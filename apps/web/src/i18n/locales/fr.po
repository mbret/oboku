msgstr "Toujours"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "Amazon accepts no comic archive by email, and oboku converts nothing."
msgstr "Amazon n'accepte aucune archive de bande dessinée par e-mail, et oboku ne convertit rien."

#: src/settings/ReadingSettings.tsx
msgid "Automatic (based on device)"
msgstr "Automatique (selon l'appareil)"

#: src/pages/SettingsScreen.tsx
msgid "Automatically hide directives from collection name"
msgstr "Masquer automatiquement les directives dans le nom des collections"

#: src/settings/ReadingSettings.tsx
