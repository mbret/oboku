#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "{maxSendsPerDay} books a day"
msgstr "{maxSendsPerDay} livres par jour"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "1. Approve oboku in your Amazon account"
msgstr "1. Approuvez oboku dans votre compte Amazon"

#: src/integrations/kindle/SendToKindleScreen.tsx
