msgstr "Affiche l'heure par-dessus le livre (sauf pour les bandes dessinées)"

#: src/theme/themeOptions.ts
msgid "E-ink"
msgstr "E-ink"

#: src/integrations/kindle/SendToKindleListItem.tsx
msgid "Email a book of your library to your Kindle"
msgstr "Envoyez un livre de votre bibliothèque à votre Kindle par e-mail"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "Enter an address that ends with @kindle.com"
msgstr "Saisissez une adresse qui se termine par @kindle.com"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "EPUB, PDF and text files"
msgstr "Fichiers EPUB, PDF et texte"

#: src/pages/SettingsScreen.tsx
msgid "General"
msgstr "Général"

#: src/pages/profile/InstallAppListItem.tsx
msgid "Install the app"
msgstr "Installer l'application"

#: src/settings/ReadingSettings.tsx
msgid "Keep screen on"
msgstr "Garder l'écran allumé"

#: src/pages/SettingsScreen.tsx
msgid "Language"
msgstr "Langue"

#: src/theme/themeOptions.ts
msgid "Light"
msgstr "Clair"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "Limits"
msgstr "Limites"

#: src/settings/ReadingSettings.tsx
msgid "Never"
msgstr "Jamais"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "Not for a book added from a device"
msgstr "Pas pour un livre ajouté depuis un appareil"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "oboku can email a book of your library to your Kindle. oboku's server reads the book from its source, then sends it with Amazon's Send to Kindle."
msgstr "oboku peut envoyer un livre de votre bibliothèque à votre Kindle par e-mail. Le serveur d'oboku lit le livre depuis sa source, puis l'envoie avec le service Envoyer vers Kindle d'Amazon."

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "oboku stops sending books to this Kindle"
msgstr "oboku n'envoie plus de livres à ce Kindle"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "oboku stops sending books to this Kindle. The address stays approved in your Amazon account."
msgstr "oboku n'envoie plus de livres à ce Kindle. L'adresse reste approuvée dans votre compte Amazon."

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "oboku tells you when the email left. Amazon then delivers the book, most often in a few minutes. If a book does not arrive, check that the address above is approved."
msgstr "oboku vous prévient quand l'e-mail est parti. Amazon livre ensuite le livre, le plus souvent en quelques minutes. Si un livre n'arrive pas, vérifiez que l'adresse ci-dessus est approuvée."

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "oboku's server cannot reach a file that is only on your device."
msgstr "Le serveur d'oboku ne peut pas atteindre un fichier qui se trouve seulement sur votre appareil."

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "On Amazon's website, open \"Manage Your Content and Devices\", then \"Preferences\", then \"Personal Document Settings\". Add this address to the \"Approved Personal Document E-mail List\". Amazon ignores the emails of any other sender."
msgstr "Sur le site d'Amazon, ouvrez « Gérer votre contenu et vos appareils », puis « Préférences », puis « Paramètres des documents personnels ». Ajoutez cette adresse à la « Liste d'adresses e-mail approuvées pour les documents personnels ». Amazon ignore les e-mails de tout autre expéditeur."

#: src/pages/SettingsScreen.tsx
msgid "Only when unlocked (safe)"
msgstr "Seulement une fois déverrouillé (sûr)"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "Open the actions of a book, then tap \"Send to Kindle\"."
msgstr "Ouvrez les actions d'un livre, puis touchez « Envoyer vers Kindle »."

#: src/settings/ReadingSettings.tsx
msgid "Prevent the device screen from turning off while reading"
msgstr "Empêche l'écran de s'éteindre pendant la lecture"

#: src/pages/SettingsScreen.tsx
msgid "Privacy & sensitive content"
msgstr "Confidentialité et contenu sensible"

