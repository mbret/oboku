msgstr "2. Enregistrez l'adresse de votre Kindle"

#: src/integrations/kindle/SendToKindleScreen.tsx
msgid "3. Send a book"
msgstr "3. Envoyez un livre"

#: src/integrations/kindle/SendBookToKindleListItemButton.tsx
