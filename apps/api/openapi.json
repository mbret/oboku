  "info": {
    "title": "oboku API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AuthProofPublicKeyDto": {
        "type": "object",
        "properties": {
          "kty": {
            "type": "string"
          },
          "crv": {
            "type": "string"
          },
          "x": {
            "type": "string",
            "maxLength": 256
          },
          "y": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "kty",
          "crv",
          "x",
          "y"
        ]
      },
      "SignInWithEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "public_key": {
            "$ref": "#/components/schemas/AuthProofPublicKeyDto"
          }
        },
        "required": [
          "email",
          "password",
          "installation_id",
          "public_key"
        ]
      },
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "dbName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "nameHex": {
            "type": "string"
          },
          "sessionId": {
            "type": "string",
            "description": "Non-secret identity minted fresh for this sign-in. The client stores it on\nthe session and later presents it to `logout` to revoke exactly this\nsession, regardless of which refresh cookie currently sits in the jar."
          }
        },
        "required": [
          "dbName",
          "email",
          "nameHex",
          "sessionId"
        ]
      },
      "SignInWithGoogleDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "public_key": {
            "$ref": "#/components/schemas/AuthProofPublicKeyDto"
          }
        },
        "required": [
          "token",
          "installation_id",
          "public_key"
        ]
      },
      "RequestSignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "EmptyResponseDto": {
        "type": "object",
        "properties": {}
      },
      "CompleteSignUpDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "CompleteSignUpResponseDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "RequestMagicLinkDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "CompleteMagicLinkDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "public_key": {
            "$ref": "#/components/schemas/AuthProofPublicKeyDto"
          }
        },
        "required": [
          "token",
          "installation_id",
          "public_key"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "session_id"
        ]
      },
      "AdminBroadcastNotificationDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "number",
            "nullable": true,
            "enum": [
              null
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "admin_broadcast"
            ]
          },
          "id": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "success",
              "warning",
              "error"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "nullable": true
          },
          "seenAt": {
            "type": "string",
            "nullable": true
          },
          "archivedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "data",
          "kind",
          "id",
          "createdAt",
          "severity",
          "title",
          "body",
          "seenAt",
          "archivedAt"
        ]
      },
      "SyncFinishedNotificationDataDto": {
        "type": "object",
        "properties": {
          "datasourceId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ]
          }
        },
        "required": [
          "datasourceId",
          "state"
        ]
      },
      "SyncFinishedNotificationDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sync_finished"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/SyncFinishedNotificationDataDto"
          },
          "id": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "success",
              "warning",
              "error"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "nullable": true
          },
          "seenAt": {
            "type": "string",
            "nullable": true
          },
          "archivedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "kind",
          "data",
          "id",
          "createdAt",
          "severity",
          "title",
          "body",
          "seenAt",
          "archivedAt"
        ]
      },
      "UnreadNotificationsCountResponseDto": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          }
        },
        "required": [
          "count"
        ]
      },
      "OkResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "KoreaderSyncServerResponseDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "What devices sign in with as username: the account email."
          },
          "passwordCreatedAt": {
            "type": "string",
            "nullable": true,
            "description": "When the current password was generated, `null` while sync is off."
          }
        },
        "required": [
          "username",
          "passwordCreatedAt"
        ]
      },
      "KoreaderSyncServerPasswordResponseDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "Shown once: only a hash of it is kept."
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "KoreaderSyncConnectionDto": {
        "type": "object",
        "properties": {
          "serverUrl": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "connectedAt": {
            "type": "string",
            "description": "When the user signed in to the server from oboku."
          }
        },
        "required": [
          "serverUrl",
          "username",
          "connectedAt"
        ]
      },
      "KoreaderSyncConnectionResponseDto": {
        "type": "object",
        "properties": {
          "connection": {
            "nullable": true,
            "description": "`null` while oboku's reader is not connected to a sync server.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/KoreaderSyncConnectionDto"
              }
            ]
          }
        },
        "required": [
          "connection"
        ]
      },
      "ConnectKoreaderSyncServerDto": {
        "type": "object",
        "properties": {
          "serverUrl": {
            "type": "string",
            "format": "uri"
          },
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "Sent once: the API keeps only the key sync clients derive from it.",
            "minLength": 1
          }
        },
        "required": [
          "serverUrl",
          "username",
          "password"
        ]
      }
    }
  }
}
