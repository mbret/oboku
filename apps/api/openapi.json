    "/notifications": {
      "get": {
        "operationId": "Notifications_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/AdminBroadcastNotificationDto"
                      },
                      {
                        "$ref": "#/components/schemas/SyncFinishedNotificationDto"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "kind",
                      "mapping": {
                        "admin_broadcast": "#/components/schemas/AdminBroadcastNotificationDto",
                        "sync_finished": "#/components/schemas/SyncFinishedNotificationDto"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Notifications"
        ]
      }
    },
