  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AuthProofPublicKeyDto": {
        "type": "object",
        "properties": {
          "kty": {
            "type": "string"
          },
          "crv": {
            "type": "string"
          },
          "x": {
            "type": "string",
            "maxLength": 256
          },
          "y": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "kty",
          "crv",
          "x",
          "y"
        ]
      },
      "SignInWithEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "public_key": {
            "$ref": "#/components/schemas/AuthProofPublicKeyDto"
          }
        },
        "required": [
          "email",
          "password",
          "installation_id",
          "public_key"
        ]
      },
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "dbName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "nameHex": {
            "type": "string"
          },
          "sessionId": {
            "type": "string",
            "description": "Non-secret identity minted fresh for this sign-in. The client stores it on\nthe session and later presents it to `logout` to revoke exactly this\nsession, regardless of which refresh cookie currently sits in the jar."
          }
        },
        "required": [
          "dbName",
          "email",
          "nameHex",
          "sessionId"
        ]
      },
      "SignInWithGoogleDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "public_key": {
            "$ref": "#/components/schemas/AuthProofPublicKeyDto"
          }
        },
        "required": [
          "token",
          "installation_id",
          "public_key"
        ]
      },
      "RequestSignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "EmptyResponseDto": {
        "type": "object",
        "properties": {}
      },
      "CompleteSignUpDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "CompleteSignUpResponseDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "RequestMagicLinkDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "CompleteMagicLinkDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "public_key": {
            "$ref": "#/components/schemas/AuthProofPublicKeyDto"
          }
        },
        "required": [
          "token",
          "installation_id",
          "public_key"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "session_id"
        ]
      }
    }
  }
}
