    "test": "vitest run"
  },
  "dependencies": {
    "@prose-reader/archive-reader": "^1.334.0",
    "@prose-reader/shared": "^1.334.0",
    "@zip.js/zip.js": "^2.8.34"
  },
  "devDependencies": {
    "vite": "^8.1.5"
