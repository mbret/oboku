{
  "name": "@oboku/archive-metadata",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./web": {
      "source": "./src/web.ts",
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "license": "MIT",
  "files": [
    "/dist"
